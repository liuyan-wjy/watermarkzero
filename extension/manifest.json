{
  "manifest_version": 3,
  "name": "Gemini Watermark Remover",
  "version": "1.0.0",
  "description": "Remove visible Gemini watermarks locally in your browser. No image uploads.",
  "homepage_url": "https://watermarkzero.org",
  "action": {
    "default_title": "Gemini Watermark Remover",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
